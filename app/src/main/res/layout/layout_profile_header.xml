<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
    android:layout_height="180dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"

        android:background="@color/white"
        android:layout_height="match_parent">

        <!-- Dot Pattern -->
        <ImageView
            android:id="@+id/ivPattern"
            android:layout_width="120dp"
            android:layout_height="80dp"
            android:src="@drawable/dot_pattern"
            android:alpha="0.25"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Profile Image -->

        <com.google.android.material.card.MaterialCardView
        android:id="@+id/profileImageCard"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Light Green Circle -->

            <View
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_profile_green_circle"/>

            <!-- Profile Image -->

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:shapeAppearanceOverlay="@style/CircleImage"/>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:text="Shahzad Ansari"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toEndOf="@id/profileImageCard"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Edit Profile"
            android:textAllCaps="false"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/primaryColor"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:cornerRadius="18dp"
            app:strokeColor="@color/primaryColor"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/primaryColor"
            app:iconPadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutMemberSince"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/layoutMemberSince"
            />
        <LinearLayout
            android:id="@+id/layoutUserBadge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_user_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintStart_toStartOf="@id/tvName"
            app:layout_constraintTop_toBottomOf="@id/tvName">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_crown"
                app:tint="@color/primaryColor"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="USER"
                android:textColor="@color/primaryColor"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/layoutUserBadge"
            app:layout_constraintTop_toBottomOf="@id/layoutUserBadge">

            <!-- Icon Background -->

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_profile_icon_circle">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/primaryColor"/>

            </FrameLayout>

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="+91 98765 43210"
                android:textColor="#000000"
                android:textSize="12sp"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutMemberSince"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/layoutPhone"
            app:layout_constraintTop_toBottomOf="@id/layoutPhone">

            <!-- Icon Background -->

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_profile_icon_circle">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/primaryColor" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvMemberSince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Member since Jan 2026"
                android:textColor="#424242"
                android:textSize="12sp"
                android:textStyle="normal"/>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cameraCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toBottomOf="@id/profileImageCard"
            app:layout_constraintEnd_toEndOf="@id/profileImageCard">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:tint="@color/primaryColor"
                android:src="@drawable/ic_camera"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Remaining -->
        <!-- Name -->
        <!-- USER Badge -->
        <!-- Phone -->
        <!-- Member Since -->
        <!-- Edit Profile -->

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>