<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:paddingHorizontal="24dp">

        <!-- Circular Payment Loader -->
        <FrameLayout
            android:id="@+id/loaderContainer"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_payment_loader_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/paymentProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#009688"
                android:padding="8dp" />

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_payment_card"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <!-- Heading -->
        <TextView
            android:id="@+id/tvVerifyingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Verifying Payment"
            android:textColor="#101828"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/loaderContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvVerifyingSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Please wait while we securely&#10;verify your payment."
            android:textColor="#718096"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvVerifyingTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Booking ID Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bookingIdCard"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_booking_id_card"
            android:paddingHorizontal="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvVerifyingSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivBookingIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_booking"
                android:contentDescription="@null"
                app:tint="@color/primaryColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvBookingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Booking ID"
                android:textColor="#718096"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/ivBookingIcon"
                app:layout_constraintTop_toTopOf="@id/ivBookingIcon" />

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivBookingIcon"
                app:layout_constraintTop_toBottomOf="@id/tvBookingLabel"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Security Message -->
        <TextView
            android:id="@+id/tvSecurityMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="52dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Your payment information is encrypted&#10;and 100% secure."
            android:textColor="#718096"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- State View Overlay -->
    <include
        android:id="@+id/stateView"
        layout="@layout/view_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
