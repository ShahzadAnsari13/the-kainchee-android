<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.location.fragment.MapFragment">

    <!-- Google Map -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search for your location"
            android:drawableStart="@drawable/ic_search"
            android:textSize="13sp"
            android:drawablePadding="8dp"
            android:background="@null"
            android:textColorHint="@color/otp_filled"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Current Location Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCurrentLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go to current location"
        android:textColor="@color/primaryColor"
        app:backgroundTint="@color/white"
        app:cornerRadius="4dp"
        app:icon="@drawable/ic_curr_loc"
        app:iconTint="@color/primaryColor"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/cv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

    <!-- Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Change Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChange"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:text="Change"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/primaryColor"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gray"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="6dp"
                android:minHeight="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Title -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvhead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="6dp"
                android:text="Pundag"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnChange"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Full Address -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvfullAdd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Pundag, Ranchi, Jharkhand, 834004"
                android:textColor="@color/gray"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:paddingStart="18dp"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/tvhead"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnChange"/>

            <!-- Set Location Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetLocation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Set Location"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/primaryColor"
                app:cornerRadius="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvfullAdd"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>