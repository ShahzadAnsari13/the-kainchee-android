<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_white">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/bg_privacy_icon">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_privacy_shield"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#17181C"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Your privacy matters to us"
                    android:textColor="#777A82"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_share_close"
            android:src="@drawable/ic_close"
            app:tint="@color/black"
            android:contentDescription="Close" />

    </LinearLayout>


    <!-- Last Updated -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="13dp"
        android:background="@drawable/bg_privacy_last_updated">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_document"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Updated"
                android:textColor="#777A82"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvLastUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="September 2026"
                android:textColor="#17181C"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">


            <!-- INTRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_privacy_intro">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your privacy, explained"
                    android:textColor="#17181C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="THE KAINCHEE respects your privacy. This Privacy Policy explains how we collect, use, store, and protect your information when you use our user-facing services, including our mobile applications, website, and related services."
                    android:textColor="#64676E"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Information We Collect"
                    android:textColor="#17181C"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Account -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account Information"
                    android:textColor="#17181C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="We collect information such as your name and mobile number to create and manage your account and verify your identity through OTP."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address &amp; Location"
                    android:textColor="#17181C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="We may collect the address details you provide and location information, such as latitude and longitude, to provide location-based services, including showing nearby and relevant parlours and services. Your location information is not shared with parlours for their own use."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- Booking -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking Information"
                    android:textColor="#17181C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="When you make a booking, we process information such as the selected parlour, services, stylist, booking date and time, and payment mode or status. Your account information may be associated with the booking to manage and fulfill your appointment. Relevant booking information may be provided to the selected parlour where necessary to provide the booked service."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- Wallet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wallet &amp; Referral Information"
                    android:textColor="#17181C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="We may maintain information related to your wallet balance, wallet transactions, referrals, and rewards to process payments, eligible refunds, referral benefits, and maintain your transaction and reward history."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- Ratings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ratings &amp; Reviews"
                    android:textColor="#17181C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="You may provide ratings for parlours and staff and optionally submit a written review after a booking. This information may be associated with the relevant booking and used to display ratings and help us understand and improve service quality."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- Notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notification Information"
                    android:textColor="#17181C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="We may collect and store a device notification token to send important notifications related to your bookings, account, refunds, rewards, and other app activities."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="How We Use Your Information"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We may use your information to:"
                    android:textColor="#17181C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="• Create and manage your account and verify your identity through OTP.&#10;&#10;• Provide location-based discovery, including nearby and trending parlours and relevant services.&#10;&#10;• Create, manage, and fulfill bookings.&#10;&#10;• Process payments, manage wallet transactions, process eligible refunds, and administer referral rewards.&#10;&#10;• Maintain and display ratings and reviews.&#10;&#10;• Send booking, account, cancellation, refund, referral, reward, and other important notifications.&#10;&#10;• Provide customer support for account, booking, cancellation, and refund-related matters.&#10;&#10;• Operate, maintain, and improve our services and user experience."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Payments"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Online payments are processed through Razorpay. We may retain payment-related information, such as transaction or payment references and payment status, to verify payments, manage bookings, process refunds, and assist with payment-related issues. We do not store sensitive payment credentials such as card PINs, CVVs, UPI PINs, or banking passwords on our servers."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Third-Party Services"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We use certain third-party services to support features of THE KAINCHEE:"
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="• Google Services — to support location and mapping functionality and location-based discovery.&#10;&#10;• Razorpay — to process online payments.&#10;&#10;• Firebase Cloud Messaging — to deliver push notifications."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Data Security"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We use reasonable technical and organizational measures to protect your information. These measures include authentication, access controls, and encrypted communication such as HTTPS when information is transmitted between the app and our servers. However, no method of transmission or storage can be guaranteed to be completely secure."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Data Retention"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We retain information for as long as reasonably necessary to provide our services, maintain booking and transaction records, provide customer support, and meet applicable operational or legal requirements."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Your Rights"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You may contact us if you believe your personal information is inaccurate or if you have questions about how your information is used. You may also contact customer support to request correction of inaccurate information or ask questions about your personal information. We will review such requests and respond as appropriate under applicable laws and our operational requirements."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Children’s Privacy"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Our services are not restricted to a particular age group. Where applicable, we handle information relating to children in accordance with applicable laws and any required parental or guardian involvement."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Changes to This Privacy Policy"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We may update this Privacy Policy from time to time to reflect changes in our services, information practices, or applicable requirements. The updated version will be made available through our user-facing services, and the “Last Updated” date will be revised accordingly."
                    android:textColor="#686B72"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Contact Us"
                android:textColor="#17181C"
                android:textSize="19sp"
                android:textStyle="bold" />


            <!-- Contact Support CTA -->
            <LinearLayout
                android:id="@+id/layoutContactSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_privacy_support">

                <LinearLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:background="@drawable/bg_privacy_support_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_support"
                        android:contentDescription="@null" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Need help?"
                        android:textColor="#17181C"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Contact us through the Contact Support section in the app."
                        android:textColor="#686B72"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- Bottom Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Thank you for trusting THE KAINCHEE."
                android:textColor="#92959C"
                android:textSize="12sp"
                android:paddingBottom="12dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>