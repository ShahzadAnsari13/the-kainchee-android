<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEmptyState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="40dp">

    <ImageView
        android:id="@+id/ivEmptySearch"
        android:layout_width="240dp"
        android:layout_height="160dp"
        android:contentDescription="No results"
        android:src="@drawable/ic_search_empty" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="No parlours found"
        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="We couldn't find any parlours&#10;matching your search.&#10;Try a different name or adjust filters."
        android:textColor="#66747D"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearSearch"
        android:layout_width="180dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="Clear Search"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:backgroundTint="#00695C"
        app:cornerRadius="14dp" />

</LinearLayout>