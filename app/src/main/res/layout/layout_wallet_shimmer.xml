<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F8FCFB"
    app:strokeWidth="1dp"
    app:strokeColor="#E7ECEB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:padding="16dp">

        <!-- Wallet Icon -->

        <View
            android:id="@+id/viewWallet"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shimmer_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Wallet Title -->

        <View
            android:id="@+id/viewTitle"
            android:layout_width="90dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintStart_toEndOf="@id/viewWallet"
            app:layout_constraintTop_toTopOf="@id/viewWallet"/>

        <!-- Wallet Balance -->

        <View
            android:id="@+id/viewBalance"
            android:layout_width="120dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintStart_toStartOf="@id/viewTitle"
            app:layout_constraintTop_toBottomOf="@id/viewTitle"/>

        <!-- Available Balance Chip -->

        <View
            android:id="@+id/viewChip"
            android:layout_width="100dp"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shimmer_round"
            app:layout_constraintStart_toStartOf="@id/viewBalance"
            app:layout_constraintTop_toBottomOf="@id/viewBalance"/>

        <!-- Transactions -->

        <View
            android:id="@+id/viewTransaction"
            android:layout_width="90dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_shimmer_round"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/viewBalance"
            app:layout_constraintBottom_toBottomOf="@id/viewBalance"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>