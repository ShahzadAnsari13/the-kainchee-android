<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rating_bottom_sheet">

    <!-- Bottom Sheet Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutChecking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="36dp"
                android:paddingBottom="32dp">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rating_loader_circle">

                    <ImageView
                        android:id="@+id/ivRatingLoader"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_scissors"
                        android:contentDescription="@null" />

                    <ProgressBar
                        android:id="@+id/progressRatingCheck"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/teal_primary"
                        android:alpha="0.85" />

                </FrameLayout>


                <!-- Main Heading -->
                <TextView
                    android:id="@+id/tvLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Just a moment..."
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvLoadingSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Checking if you've already&#10;rated this booking"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />


                <!-- Loading Dots -->
                <LinearLayout
                    android:id="@+id/loadingDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotOne"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_rating_dot_active" />

                    <View
                        android:id="@+id/dotTwo"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_rating_dot" />

                    <View
                        android:id="@+id/dotThree"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_rating_dot" />

                </LinearLayout>


                <!-- Information Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_rating_info"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        android:contentDescription="@null"
                        app:tint="@color/teal_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="We're checking if you've already rated this booking."
                        android:textColor="#536360"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:visibility="gone">


                <!-- ================= HEADER ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Left spacer -->
                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <!-- Leaf -->
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_leaf"
                            android:contentDescription="@null"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rate Your Visit"
                            android:textColor="#111111"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Your feedback helps us grow ❤️"
                            android:textColor="#6F7775"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <!-- Close -->
                    <ImageView
                        android:id="@+id/ivCloseRating"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        android:contentDescription="Close"
                        app:tint="#222222" />

                </LinearLayout>


                <!-- ================= PARLOUR INFO ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="#F7F9F8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="11dp">

                        <ImageView
                            android:id="@+id/ivParlour"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_booking"
                            android:background="@drawable/bg_service_image"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvParlourName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Urban Craft Men's Studio"
                                android:textColor="#151515"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvParlourLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Pundag, Jharkhand"
                                android:textColor="#777777"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= PARLOUR RATING ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <!-- Parlour Icon -->
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_rating_parlour_icon">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_store"
                            android:contentDescription="@null"
                            app:tint="@color/teal_primary" />

                    </FrameLayout>


                    <!-- Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How was the parlour?"
                            android:textColor="#161616"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rate your overall experience"
                            android:textColor="#747A78"
                            android:textSize="12sp" />

                        <RatingBar
                            android:id="@+id/ratingBarParlour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:isIndicator="false"
                            android:numStars="5"
                            android:rating="0"
                            android:progressTint="@color/primaryColor"
                            android:stepSize="1"
                            android:secondaryProgress="0" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================= STAFF RATING ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <!-- Staff Icon -->
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_rating_staff_icon">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            android:contentDescription="@null"
                            app:tint="#596B72" />

                    </FrameLayout>


                    <!-- Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How was your stylist?"
                            android:textColor="#161616"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rate the service by your stylist"
                            android:textColor="#747A78"
                            android:textSize="12sp" />

                        <RatingBar
                            android:id="@+id/ratingBarStaff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:isIndicator="false"
                            android:numStars="5"
                            android:rating="0"
                            android:stepSize="1"

                            android:progressTint="@color/primaryColor"
                            android:secondaryProgress="0" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================= REVIEW HEADER ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_comment"
                        android:contentDescription="@null"
                        app:tint="#202020" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Share your experience"
                        android:textColor="#171717"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="(Optional)"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- ================= REVIEW ================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#FAFAFA"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#D9DEDC"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#888888">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReview"
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:gravity="top|start"
                        android:hint="Tell us about your visit..."
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="300"
                        android:padding="13dp"
                        android:textSize="13sp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Character Count -->
                <TextView
                    android:id="@+id/tvReviewCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingTop="2dp"
                    android:text="0/300"
                    android:textColor="#777777"
                    android:textSize="11sp" />


                <!-- ================= SUBMIT ================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitRating"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp"
                    android:text="Submit Rating"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/teal_primary"
                    app:cornerRadius="26dp"
                    app:elevation="0dp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutAlreadyRated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp"
                android:visibility="gone">


                <!-- Top illustration -->
                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/ivAlreadyRatedIllustration"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:src="@drawable/ic_rating_already"
                        android:contentDescription="@null" />

                </FrameLayout>


                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:text="You've Already Rated&#10;This Booking"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp" />


                <!-- Subtitle -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Thanks for sharing your valuable&#10;feedback!"
                    android:textColor="#707775"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1dp" />


                <!-- Previous Rating Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    app:cardBackgroundColor="#F5F7F6"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">


                        <!-- ================= HEADER ================= -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_history"
                                android:contentDescription="@null"
                                app:tint="#444444" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Your Previous Rating"
                                android:textColor="#303030"
                                android:textSize="11sp"
                                android:textStyle="bold" />


                        </LinearLayout>


                        <!-- ================= PARLOUR ================= -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical|bottom"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivRatedParlour"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_store"
                                android:tint="@color/black"
                                android:contentDescription="@null" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvRatedParlourName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Urban Craft Men's Studio"
                                    android:textColor="#292D2C"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <RatingBar
                                        android:id="@+id/ratingBarPreviousParlour"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:isIndicator="true"
                                        android:numStars="5"
                                        android:rating="4"
                                        style="?android:attr/ratingBarStyleSmall"
                                        android:progressTint="@color/primaryColor"
                                        android:stepSize="1" />

                                    <TextView
                                        android:id="@+id/tvPreviousParlourRating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:text="4.0"
                                        android:textColor="#333333"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>


                        <!-- ================= STAFF ================= -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical|bottom"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivRatedStaff"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_person"
                                android:contentDescription="@null" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvRatedStaffName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Your Stylist"
                                    android:textColor="#292D2C"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <RatingBar
                                        android:id="@+id/ratingBarPreviousStaff"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:isIndicator="true"
                                        android:numStars="5"
                                        android:rating="5"

                                        style="?android:attr/ratingBarStyleSmall"
                                        android:progressTint="@color/primaryColor"
                                        android:stepSize="1" />

                                    <TextView
                                        android:id="@+id/tvPreviousStaffRating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:text="5.0"
                                        android:textColor="#333333"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>


                        <!-- ================= REVIEW ================= -->

                        <TextView
                            android:id="@+id/tvPreviousReview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:background="@drawable/bg_previous_rating_review"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp"
                            android:text="“Great service and very professional staff.&#10;Will visit again!”"
                            android:textColor="#5F6664"
                            android:textSize="11sp"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Close -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseAlreadyRated"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_marginTop="10dp"
                    android:text="Close"
                    android:textAllCaps="false"
                    android:textColor="@color/teal_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/teal_primary"
                    app:strokeWidth="1dp"
                    app:elevation="0dp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutSubmitted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:visibility="gone">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieSuccess"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="28dp"
                    android:padding="20dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/booking_success"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thank You!"
                    android:textColor="#111111"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Your feedback means a lot ❤️"
                    android:textColor="#777777"
                    android:textSize="14sp" />

                <!-- Benefits -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_rating_info"
                    android:gravity="center"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="♥&#10;Better&#10;services"
                        android:textColor="@color/teal_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="45dp"
                        android:background="#DCE7E3" />

                    <TextView
