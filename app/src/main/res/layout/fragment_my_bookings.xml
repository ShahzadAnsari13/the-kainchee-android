<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@android:color/white"
    android:layout_height="match_parent">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUpcoming"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:checkable="true"
            app:chipStrokeWidth="1dp"
            android:textSize="11dp"
            app:chipIcon="@drawable/ic_calendar"
            app:chipIconVisible="true"
            app:chipIconTint="@color/primaryColor"
            app:chipStrokeColor="@drawable/chip_stroke_selector"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:text="Upcoming"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCompleted"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checkable="true"

            android:textSize="11dp"
            app:chipIcon="@drawable/ic_check"
            app:chipIconVisible="true"
            app:chipIconTint="@color/primaryColor"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="@drawable/chip_stroke_selector"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:text="Completed"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCancelled"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checkable="true"
            android:textSize="11dp"
            app:chipIcon="@drawable/ic_cancel"
            app:chipIconTint="@color/red"
            app:chipIconVisible="true"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="@drawable/chip_stroke_selector"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:text="Cancelled"/>

    </com.google.android.material.chip.ChipGroup>

    <!-- Divider -->

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:background="#EAEAEA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroup"/>

    <!-- Main Content -->

    <FrameLayout
        android:id="@+id/flMainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Recycler -->

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                tools:listitem="@layout/item_my_booking"/>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include
                    layout="@layout/item_shimmer_my_bookings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <include
                    layout="@layout/item_shimmer_my_bookings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <include
                    layout="@layout/item_shimmer_my_bookings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>
        <include
            android:id="@+id/stateView"
            android:visibility="gone"
            layout="@layout/view_state"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>