<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1.5dp"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">



        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImage"
                android:layout_width="76dp"
                android:layout_height="76dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivService"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_no_data"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_price_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="₹199"
                android:textColor="@color/primaryColor"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Service Name -->

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ll"
            app:layout_constraintTop_toTopOf="@id/ll">

            <!-- Service Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Hair Cut"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Action Container -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- ADD BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"

                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:backgroundTint="@color/white"

                    android:text="ADD"
                    android:minWidth="80dp"
                    android:textColor="@color/primaryColor"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    app:cornerRadius="18dp" />

                <!-- ADDED STATE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdded"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/white"

                    style="@style/Widget.Material3.Button.OutlinedButton"

                    android:text="ADDED ✓"

                    android:minWidth="80dp"
                    android:textAllCaps="false"
                    android:textColor="@color/primaryColor"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="18dp" />

            </FrameLayout>

        </LinearLayout>

        <!-- Duration -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="⏱ 30 min"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/ll"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Professional stylish haircut with expert stylist"
            android:textColor="@color/gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ll"
            app:layout_constraintTop_toBottomOf="@id/tvDuration"/>

        <!-- Price -->


        <!-- Add Button -->


        <!-- Unavailable -->
        <TextView
            android:id="@+id/tvUnavailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_unavailable"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Unavailable"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/ll"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>