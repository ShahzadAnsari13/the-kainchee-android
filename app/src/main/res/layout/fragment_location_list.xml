<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".presentation.location.fragment.LocationListFragment">

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/white"
        app:cardElevation="2dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search for your location"
            android:drawableStart="@drawable/ic_search"
            android:textSize="13sp"
            android:drawablePadding="8dp"
            android:background="@null"
            android:textColorHint="@color/otp_filled"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:cursorVisible="true"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCurrentLocation"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:backgroundTint="@color/white"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_curr_loc"
                android:tint="@color/primaryColor"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use current location"
                android:textColor="@color/primaryColor"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Header -->
    <TextView
        android:id="@+id/tvSaved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saved addresses"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/gray"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardCurrentLocation"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvAddNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_add"
        android:gravity="center_vertical"
        android:drawablePadding="4dp"
        android:text="ADD NEW ADDRESS"
        android:textColor="@color/primaryColor"
        android:textStyle="bold"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/tvSaved"
        app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLocations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSaved"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>