<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F8FCFB"
    app:strokeWidth="1dp"
    app:strokeColor="#E7ECEB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:padding="16dp">

        <!-- Wallet Image -->

        <ImageView
            android:id="@+id/ivWallet"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wallet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->

        <TextView
            android:id="@+id/tvWalletTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Wallet Balance"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/ivWallet"
            app:layout_constraintTop_toTopOf="@id/ivWallet" />

        <!-- Balance -->

        <TextView
            android:id="@+id/tvWalletBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="₹1,250.00"
            android:textColor="#00695C"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvWalletTitle"
            app:layout_constraintTop_toBottomOf="@id/tvWalletTitle" />

        <!-- Available Balance -->

        <TextView
            android:id="@+id/tvAvailableBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_user_badge"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:paddingVertical="4dp"
            android:text="Available Balance"
            android:textColor="#00A651"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/tvWalletBalance"
            app:layout_constraintTop_toBottomOf="@id/tvWalletBalance" />

        <!-- Arrow Circle -->
        <LinearLayout
            android:id="@+id/layoutTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/tvWalletBalance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvWalletBalance"
            app:layout_constraintTop_toTopOf="@id/tvWalletBalance">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/primaryColor" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTransaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                android:gravity="center_vertical"
                android:textColor="@color/primaryColor"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
        <!-- View Transactions -->



    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>