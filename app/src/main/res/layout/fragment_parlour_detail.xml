<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Skeleton layout -->
        <include layout="@layout/layout_parlour_shimmer"/>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:background="@android:color/white">

        <!-- Illustration -->
        <ImageView
            android:id="@+id/imgEmpty"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_oops"
            android:contentDescription="No Data"
            android:scaleType="centerInside" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="No Data Found 😔"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We couldn’t load the details right now.\nPlease try again."
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:lineSpacingExtra="2dp" />

        <!-- Retry Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="Retry"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primaryColor"
            app:cornerRadius="12dp" />

    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- ViewPager -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerImages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintDimensionRatio="16:9"/>


                    <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                        android:id="@+id/dotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        app:dotsColor="#80FFFFFF"
                        app:dotsSize="6dp"
                        app:dotsSpacing="4dp"

                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginBottom="8dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Royal Salon"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                    <ImageView
                        android:id="@+id/ivVerified"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_verified"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>


                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.5 (120) • 📍 2.3 km"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Premium salon with expert professionals and hygienic services."
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a Service"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:visibility="gone"
                    android:focusable="true">

                    <!-- Skeleton layout -->
                    <include layout="@layout/layout_category_shimmer"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <!-- EMPTY STATE -->
                <LinearLayout
                    android:id="@+id/emptyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:src="@drawable/ic_no_data"
                        android:scaleType="centerInside"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Services Available"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This parlour currently has no services."
                        android:textSize="13sp"
                        android:textColor="@color/gray"
                        android:gravity="center"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- RECYCLER -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Near Bus Stand"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvCityState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Mithapur, Bihar"
                    android:textStyle="bold"
                    android:textSize="14sp"/>


            </LinearLayout>

            <!-- TIMING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTiming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 10:00 AM – 9:00 PM"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvClosed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Closed • Sunday"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- WHY CHOOSE US -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why Choose Us"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tvFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 6 Skilled Professionals\n• Hygienic Environment\n• UPI Payments Accepted\n• Quick Call Support"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieClosedOverlay"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"

        android:visibility="gone"

        android:clickable="false"
        android:focusable="false"

        android:alpha="0.95"

        android:scaleX="1.08"
        android:scaleY="1.08"

        android:translationY="-20dp"

        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/closed_animation"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>