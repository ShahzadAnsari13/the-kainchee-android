<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone"
        android:focusable="true">

        <!-- Skeleton layout -->
        <include layout="@layout/layout_parlour_shimmer"/>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <include
        android:id="@+id/stateView"
        android:visibility="gone"
        layout="@layout/view_state"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- ViewPager -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerImages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintDimensionRatio="16:9"/>
                    <LinearLayout
                        android:id="@+id/laIsOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_trending_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/noun_trend_chart_7969412"
                            app:tint="@android:color/white"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="OPEN NOW"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                        android:id="@+id/dotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        app:dotsColor="#80FFFFFF"
                        app:dotsSize="6dp"
                        app:dotsSpacing="4dp"

                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginBottom="8dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Royal Salon"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                    <ImageView
                        android:id="@+id/ivVerified"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_verified"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>


                <TextView
                    android:id="@+id/tvRatingAndMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.5 (120) • 📍 2.3 km"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Premium salon with expert professionals and hygienic services."
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore Services"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:visibility="gone"
                    android:focusable="true">

                    <!-- Skeleton layout -->
                    <include layout="@layout/layout_category_shimmer"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <!-- EMPTY STATE -->
                <LinearLayout
                    android:id="@+id/emptyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:src="@drawable/ic_no_data"
                        android:scaleType="centerInside"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Services Available"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This parlour currently has no services."
                        android:textSize="13sp"
                        android:textColor="@color/gray"
                        android:gravity="center"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- RECYCLER -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Near Bus Stand"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvCityState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Mithapur, Bihar"
                    android:textStyle="bold"
                    android:textSize="14sp"/>


            </LinearLayout>

            <!-- TIMING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTiming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 10:00 AM – 9:00 PM"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvClosed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Closed • Sunday"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- WHY CHOOSE US -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why Choose Us"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tvFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 6 Skilled Professionals\n• Hygienic Environment\n• UPI Payments Accepted\n• Quick Call Support"
                    android:textSize="13sp"
                    android:textColor="@color/gray"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieClosedOverlay"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"

        android:visibility="gone"

        android:clickable="false"
        android:focusable="false"

        android:alpha="0.95"

        android:scaleX="1.08"
        android:scaleY="1.08"

        android:translationY="-20dp"

        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/closed_animation"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomBookingStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/primaryColor"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- ICON CONTAINER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"

                app:cardElevation="0dp">



                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:src="@drawable/ic_booking_service"/>



            </com.google.android.material.card.MaterialCardView>

            <!-- TEXT SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 Services Added"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Details"
                        android:textColor="#DFF5E4"
                        android:textSize="11sp"/>

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="4dp"
                        android:rotation="270"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#DFF5E4"/>

                </LinearLayout>


            </LinearLayout>

            <!-- BOOK BUTTON -->
            <LinearLayout
                android:id="@+id/btnBook"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_white_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book"
                    android:textColor="@color/primaryColor"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/primaryColor"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>