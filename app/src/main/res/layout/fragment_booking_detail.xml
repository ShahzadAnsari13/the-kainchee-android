<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/parlourHeroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="22dp"

                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="230dp">

                    <ImageView
                        android:id="@+id/ivParlourImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hero_gradient" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:gravity="bottom">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvParlourName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@android:color/white"
                                android:textSize="21sp"
                                android:textStyle="bold"
                                tools:text="Urban Craft Men's Studio" />

                            <ImageView
                                android:id="@+id/ivVerified"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_verified"
                                android:contentDescription="Verified" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvParlourAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            tools:text="Kadru Kaji House road, Pundag, Ranchi, Jharkhand 834004" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐ 4.8 (120)"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="12dp"
                                android:background="#80FFFFFF" />

                            <TextView
                                android:id="@+id/tvDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍 2.3 km"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- ACTIONS -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <ImageView
                                android:id="@+id/btnCall"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:padding="11dp"
                                android:background="@drawable/bg_circle_white"
                                android:src="@drawable/ic_booking_call"
                                android:contentDescription="Call" />

                            <ImageView
                                android:id="@+id/btnDirections"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:padding="11dp"
                                android:background="@drawable/bg_circle_white"
                                android:src="@drawable/ic_navigation"
                                android:contentDescription="Directions" />

                            <ImageView
                                android:id="@+id/btnShare"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:padding="11dp"
                                android:background="@drawable/bg_circle_white"
                                android:src="@drawable/ic_share"
                                android:contentDescription="Share" />

                            <ImageView
                                android:id="@+id/btnSupport"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:padding="11dp"
                                android:background="@drawable/bg_circle_white"
                                android:src="@drawable/ic_help_support"
                                android:contentDescription="Save" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvParlourOpenStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_status_green"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="THE KAINCHEE PARTNER"
                        android:textColor="#087F5B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= BOOKING STATUS ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/statusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:padding="13dp"
                            android:src="@drawable/ic_booking_status_pending_icon"
                            android:background="@drawable/bg_booking_status_pending"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBookingStatusTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Booking Confirmed"
                                android:textColor="#087F5B"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBookingStatusMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Your appointment is scheduled."
                                android:textColor="#777777"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_margin="10dp"
                        android:background="#DDDDDD" />
                    <!-- STATUS TIMELINE -->

                    <LinearLayout
                        android:id="@+id/statusTimeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Status nodes will be updated dynamically -->

                        <LinearLayout
                            android:id="@+id/statusPending"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPendingCheck"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:text="✓"
                                android:textSize="12sp"
                                android:textColor="@color/white"

                                android:background="@drawable/bg_booking_check_status_default"/>

                            <TextView
                                android:id="@+id/tvPendingLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Pending"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <View
                            android:id="@+id/linePendingConfirmed"
                            android:layout_width="28dp"
                            android:layout_height="2dp"
                            android:background="#D0D0D0" />

                        <LinearLayout
                            android:id="@+id/statusConfirmed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvConfirmedCheck"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_booking_check_status_default"/>

                            <TextView
                                android:id="@+id/tvConfirmedLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Confirmed"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <View
                            android:id="@+id/lineConfirmedCheckedIn"
                            android:layout_width="28dp"
                            android:layout_height="2dp"
                            android:background="#D0D0D0" />

                        <LinearLayout
                            android:id="@+id/statusCheckedIn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCheckedInCheck"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_booking_check_status_default"/>

                            <TextView
                                android:id="@+id/tvCheckedInLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Checked In"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <View
                            android:id="@+id/lineCheckedInCompleted"
                            android:layout_width="28dp"
                            android:layout_height="2dp"
                            android:background="#D0D0D0" />

                        <LinearLayout
                            android:id="@+id/statusCompleted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCompletedCheck"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_booking_check_status_default"/>

                            <TextView
                                android:id="@+id/tvCompletedLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Completed"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= APPOINTMENT ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appointmentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="horizontal">

                    <!-- DATE -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="📅  Date"
                            android:textSize="12sp"
                            android:textColor="#777777"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvBookingDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="16 Sept 2026"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBookingDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tuesday"
                            android:textColor="#777777"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="70dp"
                        android:background="#DDDDDD" />

                    <!-- TIME -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:text="🕐 Time"
                            android:textSize="12sp"
                            android:textColor="#777777"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvBookingTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="08:00 PM – 09:20 PM"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBookingDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h 20m"
                            android:textColor="#777777"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="70dp"
                        android:background="#DDDDDD" />

                    <!-- STAFF -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:paddingStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:text="👤 Stylist"
                            android:textSize="12sp"
                            android:textColor="#777777"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvStaffName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Armaan Khan"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= SERVICES ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/servicesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/servicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✂  Services"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvViewAllServices"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View All  ›"
                            android:textColor="#087F5B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/servicesListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" >


                        <com.google.android.material.card.MaterialCardView
                            xmlns:android="http://schemas.android.com/apk/res/android"
                            xmlns:app="http://schemas.android.com/apk/res-auto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E8E8E8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="8dp">

                                <!-- Service Image -->
                                <ImageView
                                    android:id="@+id/ivServiceImage"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_oops"
                                    android:clipToOutline="true"

                                    android:background="@drawable/bg_service_image"
                                    android:contentDescription="Service image" />

                                <!-- Service Info -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvServiceName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:text="Hot Oil Scalp Massage"
                                        android:textColor="@android:color/black"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvServiceDuration"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="45 mins"
                                        android:textColor="#777777"
                                        android:textSize="12sp" />

                                </LinearLayout>

                                <!-- Price -->
                                <TextView
                                    android:id="@+id/tvServicePrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="₹799"
                                    android:textColor="@android:color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/paymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:text="💳 Payment Details"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Total Amount"
                                android:textColor="#777777"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvTotalAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="₹1,398.0"
                                android:textColor="#087F5B"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="70dp"
                            android:background="#DDDDDD" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:text="Payment Method"
                                android:textColor="#777777"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvPaymentMethod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="ONLINE"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="70dp"
                            android:background="#DDDDDD" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"

                            android:paddingStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:text="Payment Status"
                                android:textColor="#777777"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvPaymentStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="PAID"
                                android:textColor="#087F5B"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= BOOKING INFO ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bookingInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="Booking ID"
                            android:textColor="#777777"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvBookingId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="#BKG20260916XY123"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:background="#DDDDDD" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:text="Booked On"
                            android:textColor="#777777"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvCreatedAt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="16 Sept 2026, 07:12 PM"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= CANCEL BUTTON ================= -->

            <TextView
                android:id="@+id/btnCancelBooking"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_cancel_booking"
                android:gravity="center"
                android:text="Cancel Booking"
                android:textColor="#D62828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Book Again will be shown for terminal states -->

            <TextView
                android:id="@+id/btnRating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_outline_primary"
                android:gravity="center"
                android:text="Share Your Experience"
                android:textColor="#087F5B"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true">

        <include
            layout="@layout/booking_detail_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </com.facebook.shimmer.ShimmerFrameLayout>
    <include
        android:id="@+id/stateView"
        android:visibility="gone"
        layout="@layout/view_state"/>



</FrameLayout>