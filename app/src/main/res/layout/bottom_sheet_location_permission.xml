<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"

    android:gravity="center_horizontal"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Location Icon -->
    <ImageView
        android:id="@+id/imgLocation"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/location_permission"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location Permission Required"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THE KAINCHEE needs your location to show nearby salons and enable accurate bookings.
Without location access, the app cannot function properly."
        android:textSize="14sp"
        android:textColor="#666666"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How to enable:\n1. Tap Open Settings\n2. Go to Permissions\n3. Allow Location"
        android:textSize="14sp"
        android:textColor="#444444"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Open Settings"
        android:textAllCaps="false"
        android:backgroundTint="@color/primaryColor"
        android:textColor="#FFFFFF"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cornerRadius="12dp"/>

    <TextView
        android:id="@+id/txtCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not Now"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

</LinearLayout>