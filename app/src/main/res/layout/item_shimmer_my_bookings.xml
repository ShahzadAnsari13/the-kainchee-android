<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- Image -->

            <View
                android:id="@+id/viewImage"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Amount -->

            <View
                android:layout_width="60dp"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintTop_toBottomOf="@id/viewImage"
                app:layout_constraintStart_toStartOf="@id/viewImage"
                app:layout_constraintEnd_toEndOf="@id/viewImage"/>

            <!-- Status -->

            <View
                android:id="@+id/viewStatus"
                android:layout_width="70dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintTop_toTopOf="@id/viewImage"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Service -->

            <View
                android:id="@+id/viewService"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="90dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintStart_toEndOf="@id/viewImage"
                app:layout_constraintTop_toTopOf="@id/viewImage"
                app:layout_constraintEnd_toStartOf="@id/viewStatus"/>

            <!-- More Services -->

            <View
                android:layout_width="100dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintTop_toBottomOf="@id/viewService"
                app:layout_constraintStart_toStartOf="@id/viewService"/>

            <!-- Parlour -->

            <View
                android:layout_width="170dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintTop_toBottomOf="@id/viewStatus"
                app:layout_constraintStart_toStartOf="@id/viewService"/>

            <!-- Staff -->

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintTop_toBottomOf="@id/viewService"
                app:layout_constraintStart_toStartOf="@id/viewService"/>

            <!-- Date -->

            <View
                android:layout_width="130dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_placeholder"
                app:layout_constraintTop_toBottomOf="@id/viewStatus"
                app:layout_constraintStart_toStartOf="@id/viewService"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"/>

        <!-- Footer -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_shimmer_placeholder"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_shimmer_placeholder"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>