<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_navigation"
    app:startDestination="@id/myProfileFragment">
    <fragment
        android:id="@+id/myProfileFragment"
        android:name="com.thekainchee.user.presentation.profile.fragment.MyProfileFragment"
        android:label="MyProfileFragment">

        <action
            android:id="@+id/action_myProfileFragment_to_walletTransactionFragment"
            app:destination="@id/walletTransactionFragment" />
        <action
            android:id="@+id/action_myProfileFragment_to_referralFragment"
            app:destination="@id/referralFragment" />
    </fragment>
    <fragment
        android:id="@+id/walletTransactionFragment"
        android:name="com.thekainchee.user.presentation.wallet.fragment.WalletTransactionFragment"
        android:label="Wallet Transactions" >
        <argument
            android:name="balance"
            app:argType="float"/>
    </fragment>
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.thekainchee.user.presentation.notification.fragment.NotificationFragment"
        android:label="Notifications" />

    <fragment android:id="@+id/referralFragment"
        android:name="com.thekainchee.user.presentation.referral.fragment.ReferralFragment"
        android:label="Referral" >
        <action
            android:id="@+id/action_referralFragment_to_referralHistoryFragment"
            app:destination="@id/referralHistoryFragment" />
    </fragment>

    <fragment android:id="@+id/referralHistoryFragment"
        android:name="com.thekainchee.user.presentation.referral.fragment.ReferralHistoryFragment"
        android:label="Referral History" >

        <argument
            android:name="referral_history"
            app:argType="com.thekainchee.user.presentation.referral.model.ReferralHistory" />
    </fragment>
</navigation>