<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavIndicator">

        <item name="android:width">48dp</item>
        <item name="android:height">20dp</item>

        <item name="shapeAppearanceOverlay">@style/IndicatorShape</item>

        <item name="backgroundColor">#E6F7EC</item>
    </style>

    <style name="IndicatorShape">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>
    <style name="ToolbarTitleStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ProfileImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>